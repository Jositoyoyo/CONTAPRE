<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Inicializa los contextos singleton; IntegrationDatabase sustituye este valor por el de Web.config. -->
    <add name="ContaPreModel" connectionString="Data Source=integration-not-configured;Initial Catalog=integration-not-configured;Integrated Security=True;Connect Timeout=1" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
